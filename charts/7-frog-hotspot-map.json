
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "FrogID occurrence record hotspots across Australia using proportional symbols.",
  "width": "container",
  "height": 460,

  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 600
  },

  "layer": [
  

{
  "data": {
   "url": "data/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "mark": {
    "type": "geoshape",
    "fill": "#E5F0E7",
    "stroke": "#315B50",
    "strokeWidth": 1.5
  },
  "encoding": {
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State"
      }
    ]
  }
}

,

  {
    "data": {
      "url": "data/grid_counts.csv"
    },
    "mark": {
      "type": "circle"
    },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "records",
          "type": "quantitative",
          "title": "Records per 1° cell",
          "scale": {
            "type": "linear",
            "domainMin": 0,
            "range": [9, 950]
          },
          "legend": {
            "orient": "right",
            "format": "~s"
          }
        },
        "tooltip": [
          {
            "field": "latitude",
            "type": "quantitative",
            "title": "Grid centre latitude",
            "format": ".1f"
          },
          {
            "field": "longitude",
            "type": "quantitative",
            "title": "Grid centre longitude",
            "format": ".1f"
          },
          {
            "field": "records",
            "type": "quantitative",
            "title": "Occurrence records",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
