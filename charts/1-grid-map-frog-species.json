
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Geographic distribution of mapped frog species richness across Australia.",

  "title": {
    "text": "Frog Species Richness Across Australia",
    "subtitle": "Number of mapped species in each geographic unit",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "fontWeight": "bold",
    "anchor": "start",
    "color": "#173D3B",
    "offset": 12
  },

  "width": "container",
  "height": 450,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "data/frog_richnes.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "stroke": null,
        "opacity": 0.95
      },

      "encoding": {
        "color": {
          "field": "properties.Sp_richnes",
          "type": "quantitative",
          "title": "Number of species",
          "scale": {
            "type": "linear",
            "domain": [1, 45],
            "range": [
              "#E8F3DC",
              "#B7D9B0",
              "#73B69B",
              "#32877E",
              "#154C52"
            ]
          },
          "legend": {
            "orient": "right",
            "gradientLength": 220,
            "gradientThickness": 14,
            "titleFontSize": 11,
            "labelFontSize": 10,
            "format": ".0f"
          }
        },

        "tooltip": [
          {
            "field": "properties.Sp_richnes",
            "type": "quantitative",
            "title": "Mapped species",
            "format": ".0f"
          }
        ]
      }
    },

    {
      "data": {
        "url": "data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fillOpacity": 0,
        "stroke": "#315B50",
        "strokeWidth": 0.9,
        "strokeOpacity": 0.8
      },

      "encoding": {
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {"state": "WA", "lon": 121, "lat": -26},
          {"state": "NT", "lon": 133, "lat": -20},
          {"state": "SA", "lon": 135, "lat": -30},
          {"state": "QLD", "lon": 144, "lat": -22},
          {"state": "NSW", "lon": 147, "lat": -32},
          {"state": "VIC", "lon": 144, "lat": -37},
          {"state": "TAS", "lon": 147, "lat": -42},
          {"state": "ACT", "lon": 149.1, "lat": -35.3}
        ]
      },

      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#173D35",
        "opacity": 0.85
      },

      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
