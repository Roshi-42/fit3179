
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Number of distinct frog species recorded in each Australian state using FrogID 7.0.",

  "title": {
    "text": "Which Australian States Have the Most Recorded Frog Species?",
    "subtitle": "Distinct species identified through FrogID observations, 2017–2024",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "anchor": "start",
    "color": "#173D3B"
  },

  "width": "container",
  "height": 430,

  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 620
  },

  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/species_by_state.csv"
        },
        "key": "state",
        "fields": [
          "species_count"
        ]
      }
    }
  ],

  "mark": {
    "type": "geoshape",
    "stroke": "#173D3B",
    "strokeWidth": 1.5
  },

  "encoding": {
    "color": {
      "field": "species_count",
      "type": "quantitative",
      "title": "Distinct frog species",
      "scale": {
        "domain": [0, 110],
        "range": [
          "#E8F3DC",
          "#B7D9B0",
          "#73B69B",
          "#32877E",
          "#154C52"
        ],
        "unknown": "#E5E7EB"
      },
      "legend": {
        "orient": "right",
        "gradientLength": 220,
        "gradientThickness": 15,
        "titleFontSize": 12,
        "labelFontSize": 11,
        "format": ".0f"
      }
    },

    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / Territory"
      },
      {
        "field": "species_count",
        "type": "quantitative",
        "title": "Distinct species",
        "format": ",.0f"
      }
    ]
  },

  "config": {
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
